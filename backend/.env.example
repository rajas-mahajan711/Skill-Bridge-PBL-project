# Express Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection
MONGODB_URI=mongodb://127.0.0.1:27017/skillbridge

# Authentication Security (Change in production)
JWT_SECRET=skillbridge_super_secret_jwt_key_change_in_production_min_32_chars
JWT_EXPIRES_IN=7d

# FastAPI AI/ML Microservice URL
AI_SERVICE_URL=http://127.0.0.1:8000

# Client Application URL (For CORS whitelist)
FRONTEND_URL=http://localhost:5173

# Private File Upload Settings
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=5
