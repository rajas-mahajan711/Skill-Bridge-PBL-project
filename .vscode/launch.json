{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Launch SkillBridge in Chrome",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:5173",
      "webRoot": "${workspaceFolder}/frontend/src",
      "preLaunchTask": "Start SkillBridge Student Portal (Auto-opens browser)"
    },
    {
      "name": "Launch SkillBridge in Edge",
      "type": "msedge",
      "request": "launch",
      "url": "http://localhost:5173",
      "webRoot": "${workspaceFolder}/frontend/src",
      "preLaunchTask": "Start SkillBridge Student Portal (Auto-opens browser)"
    }
  ]
}
