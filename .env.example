# ==========================================
# SkillBridge Platform Environment Configuration
# Copy this file to .env in backend/ and configure values
# DO NOT COMMIT REAL SECRETS OR PASSWORDS
# ==========================================

# Environment & Server
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1
CLIENT_ORIGIN=http://localhost:5173

# Database (MongoDB Mongoose)
# Replaces PostgreSQL as agreed for college-wide integration
MONGODB_URI=mongodb://localhost:27017/skillbridge
MONGODB_DEBUG=false

# Authentication & Security
JWT_SECRET=replace-with-a-secure-random-secret-key-min-32-chars
JWT_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=10

# AI/ML Microservice (Python + FastAPI)
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_TIMEOUT_MS=8000

# File Upload Conventions
MAX_UPLOAD_SIZE_MB=10
UPLOAD_DIR=./uploads

# External Connectors (Configured vs Demo Mode)
# Set to 'demo' if external APIs are not yet integrated
GITHUB_CONNECTOR_MODE=demo
LEETCODE_CONNECTOR_MODE=demo
COLLEGE_LMS_CONNECTOR_MODE=demo
